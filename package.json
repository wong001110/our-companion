{
  "name": "our-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Our Companion MVP desktop exploration companion.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/platform/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @our-companion/desktop",
    "build": "npm run build -w @our-companion/desktop",
    "build:clean": "rm -rf apps/desktop/dist && rm -rf node_modules/.vite && npm run build",
    "start": "npm run start -w @our-companion/desktop",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "lint": "tsc -b --pretty false",
    "arch:check": "node scripts/check-architecture-boundaries.mjs",
    "smoke:s5:two-device": "npm run build && playwright test tests/smoke/s5-two-device.spec.ts",
    "smoke:s5:two-device:headed": "npm run build && playwright test tests/smoke/s5-two-device.spec.ts --headed",
    "whisper:setup": "node scripts/setup-whisper.mjs"
  },
  "dependencies": {
    "electron": "^37.0.0",
    "pixi.js": "^8.9.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
